rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboard: any signed-in player can read it; each player only writes their own entry
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'rankPoints', 'leaderPokedexId', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.rankPoints is int
        && request.resource.data.rankPoints >= 0
        && request.resource.data.rankPoints <= 1000000
        && request.resource.data.leaderPokedexId is int
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
