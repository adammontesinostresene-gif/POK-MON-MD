rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Co-op expeditions: the host runs the game; other members only touch their own entry and inputs
    match /coopParties/{partyId} {
      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }
      function ownEntryOnly(field) {
        return request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid]);
      }

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['hostUid', 'hostName', 'status', 'dungeonId', 'mission', 'memberUids', 'members', 'inputs', 'game', 'createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() <= 20
        && request.resource.data.status == 'lobby'
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.inputs == {}
        && request.resource.data.createdAt == request.time;

      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      allow update: if request.auth != null && (
        // Host: drives the lobby and the expedition
        (resource.data.hostUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.memberUids.size() <= 4
          && (!('game' in request.resource.data) || request.resource.data.game == null || request.resource.data.game.size() <= 900000))
        ||
        // Join an open lobby while there is room
        (resource.data.status == 'lobby'
          && !(request.auth.uid in resource.data.memberUids)
          && changedOnly(['memberUids', 'members'])
          && ownEntryOnly('members')
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
          && request.resource.data.memberUids.size() <= 4)
        ||
        // Leave the party
        (request.auth.uid in resource.data.memberUids
          && changedOnly(['memberUids', 'members', 'inputs'])
          && ownEntryOnly('members')
          && ownEntryOnly('inputs')
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet()))
        ||
        // Own contribution and ready flag in the lobby
        (resource.data.status == 'lobby'
          && request.auth.uid in resource.data.memberUids
          && changedOnly(['members'])
          && ownEntryOnly('members'))
        ||
        // Own votes and actions during the expedition
        (request.auth.uid in resource.data.memberUids
          && changedOnly(['inputs'])
          && ownEntryOnly('inputs'))
      );
    }

    // Leaderboard: any signed-in player can read it; each player only writes their own entry
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'rankPoints', 'leaderPokedexId', 'leaderLevel', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.rankPoints is int
        && request.resource.data.rankPoints >= 0
        && request.resource.data.rankPoints <= 1000000
        && request.resource.data.leaderPokedexId is int
        && request.resource.data.leaderLevel is int
        && request.resource.data.leaderLevel >= 1
        && request.resource.data.leaderLevel <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Full game save: only its owner can read or write it
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'savedAt', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.savedAt is int
        && request.resource.data.updatedAt == request.time;
    }

    // Guilds: the founder creates/disbands it; every other player can only add or remove themselves
    match /guilds/{guildId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'ownerName', 'memberUids', 'members', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 24
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 20
        && request.resource.data.createdAt == request.time;

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && (
          // Join: add yourself while there is room
          (!(request.auth.uid in resource.data.memberUids)
            && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
            && request.resource.data.memberUids.size() <= 20
            && request.resource.data.members[request.auth.uid] is string
            && request.resource.data.members[request.auth.uid].size() <= 20)
          ||
          // Leave: remove yourself (the founder disbands instead)
          (request.auth.uid in resource.data.memberUids
            && request.auth.uid != resource.data.ownerUid
            && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().difference([request.auth.uid].toSet())
            && !(request.auth.uid in request.resource.data.members))
        );

      // Guild chat: only current members can read and write; the founder can clear it when disbanding
      match /messages/{messageId} {
        function guild() {
          return get(/databases/$(database)/documents/guilds/$(guildId)).data;
        }

        allow read: if request.auth != null && request.auth.uid in guild().memberUids;

        allow create: if request.auth != null
          && request.auth.uid in guild().memberUids
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time;

        allow delete: if request.auth != null && guild().ownerUid == request.auth.uid;
      }
    }
  }
}
